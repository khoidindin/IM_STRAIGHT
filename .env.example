# CQG Market Data Engine Environment Variables Template
# Copy this file to .env and fill in your actual credentials

# CQG Account Credentials
CQG_USERNAME=your_cqg_username_here
CQG_PASSWORD=your_cqg_password_here

# CQG Gateway Endpoints
CQG_GATEWAY_URL=wss://api-hongkong.cqg.com
CQG_WEB_URL=https://m.cqg.com/cqg/desktop/main
CQG_APP_ID=CQGDesktop

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
STREAM_RATE_HZ=10

# Engine Execution Mode: 'simulation' | 'browser_relay' | 'cqg_live'
ENGINE_MODE=simulation
